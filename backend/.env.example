# Copie para .env e preencha com os valores do seu projeto Supabase
# (Project Settings > API, e Project Settings > Database > Connection string).
# Nunca commite o .env — ele já está no .gitignore.

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# Project Settings > API > JWT Secret. Sem isso, toda chamada autenticada
# faz uma requisição extra ao Supabase só pra validar o token (mais lento,
# mas funciona); com isso setado, a validação é local (mais rápido).
SUPABASE_JWT_SECRET=

# Origens do frontend com permissão de CORS, separadas por vírgula. Já vem
# preenchido com as portas padrão do Vite (funciona em dev local sem
# precisar mudar nada). Em produção, defina com a URL publicada do
# frontend (ex: https://seu-app.onrender.com), senão o navegador bloqueia
# as chamadas — pode deixar vazio aqui e configurar só no Render.
# FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
